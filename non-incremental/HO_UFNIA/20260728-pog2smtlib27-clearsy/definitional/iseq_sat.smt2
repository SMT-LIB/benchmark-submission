(assert (!
  (forall ((X |POW POW Z|) (Y |POW Z|))
    (= (|relations.total POW Z Z| X Y)
       (|set.intent POW (POW Z x Z)|
         (lambda ((f |POW (POW Z x Z)|))
           (= (|rel.domain POW Z Z| f) X)))))
  :named |ax:set.in.relations.total (POW Z x Z)|
))
;; <-> Z POW Z
(declare-fun |relations Z POW Z| (|POW Z| |POW POW Z|) |POW POW (Z x POW Z)|)
(assert (!
  (forall ((X |POW Z|) (Y |POW POW Z|))
    (= (|relations Z POW Z| X Y)
       (|sub-sets (Z x POW Z)| (|set.product Z POW Z| X Y))))
    :named |def.relations (Z x POW Z)|))
;; functions Z POW Z
(declare-fun |functions Z POW Z| (|POW Z| |POW POW Z|) |POW POW (Z x POW Z)|)
(assert (! 
  (forall ((X |POW Z|) (Y |POW POW Z|))
      (= (|functions Z POW Z| X Y)
        (|set.intent POW (Z x POW Z)| (lambda ((f |POW (Z x POW Z)|))
            (forall ((p |(Z x POW Z)|) (q |(Z x POW Z)|))
              (=> (and (|set.in (Z x POW Z)| p f) (|set.in (Z x POW Z)| q f) (= (fst p) (fst q)) )
                  (= (snd p) (snd q))))))))
    :named |ax:set.in.functions (Z x POW Z)|))
;; dom Z POW Z
(declare-fun |rel.domain Z POW Z| (|POW (Z x POW Z)|) |POW Z|)
(assert (!
  (forall ((r |POW (Z x POW Z)|))
    (= (|rel.domain Z POW Z| r)
       (|set.intent Z|
         (lambda ((e |Z|))
           (exists ((y |POW Z|))
             (|set.in (Z x POW Z)| (maplet e y) r))))))
             :named |ax:set.in.domain (Z x POW Z)|))
;; bijections (Z x POW Z) Z
(declare-fun |bijections (Z x POW Z) Z| (|POW (Z x POW Z)| |POW Z|) |POW POW ((Z x POW Z) x Z)|)
  (assert (!
  (forall ((X |POW (Z x POW Z)|) (Y |POW Z|))
    (= (|bijections (Z x POW Z) Z| X Y)
       (|set.inter POW ((Z x POW Z) x Z)|
         (|injections (Z x POW Z) Z| X Y)
         (|surjections (Z x POW Z) Z| X Y))))
  :named |ax:set.in.bijections ((Z x POW Z) x Z)|))
;; --> (Z x POW Z) Z
(declare-fun |functions.total (Z x POW Z) Z| (|POW (Z x POW Z)| |POW Z|) |POW POW ((Z x POW Z) x Z)|)
(assert (!
  (forall ((e1 |POW (Z x POW Z)|) (e2 |POW Z|))
    (= (|functions.total (Z x POW Z) Z| e1 e2)
       (|set.intent POW ((Z x POW Z) x Z)|
         (lambda ((f |POW ((Z x POW Z) x Z)|))
           (and (|set.in POW ((Z x POW Z) x Z)| f (|functions.partial (Z x POW Z) Z| e1 e2))
            (|set.in POW ((Z x POW Z) x Z)| f (|relations.total (Z x POW Z) Z| e1 e2)))))))
  :named |ax:def.tfun ((Z x POW Z) x Z)|))
;; bijections POW Z Z
(declare-fun |bijections POW Z Z| (|POW POW Z| |POW Z|) |POW POW (POW Z x Z)|)
  (assert (!
  (forall ((X |POW POW Z|) (Y |POW Z|))
    (= (|bijections POW Z Z| X Y)
       (|set.inter POW (POW Z x Z)|
         (|injections POW Z Z| X Y)
         (|surjections POW Z Z| X Y))))
  :named |ax:set.in.bijections (POW Z x Z)|))
;; --> POW Z Z
(declare-fun |functions.total POW Z Z| (|POW POW Z| |POW Z|) |POW POW (POW Z x Z)|)
(assert (!
  (forall ((e1 |POW POW Z|) (e2 |POW Z|))
    (= (|functions.total POW Z Z| e1 e2)
       (|set.intent POW (POW Z x Z)|
         (lambda ((f |POW (POW Z x Z)|))
           (and (|set.in POW (POW Z x Z)| f (|functions.partial POW Z Z| e1 e2))
            (|set.in POW (POW Z x Z)| f (|relations.total POW Z Z| e1 e2)))))))
  :named |ax:def.tfun (POW Z x Z)|))
;; +-> Z POW Z
(declare-fun |functions.partial Z POW Z| (|POW Z| |POW POW Z|) |POW POW (Z x POW Z)|)
(assert (! 
  (forall ((e1 |POW Z|) (e2 |POW POW Z|))
    (= (|functions.partial Z POW Z| e1 e2) (|set.intent POW (Z x POW Z)|
  (lambda ((f |POW (Z x POW Z)|)) (and
  (|set.in POW (Z x POW Z)| f (|relations Z POW Z| e1 e2))
  (|set.in POW (Z x POW Z)| f (|functions Z POW Z| e1 e2)))))))
    :named |ax:def.pfun (Z x POW Z)|))
;; >->> Z POW Z
(declare-fun |relations.total Z POW Z| (|POW Z| |POW POW Z|) |POW POW (Z x POW Z)|)
(assert (!
  (forall ((X |POW Z|) (Y |POW POW Z|))
    (= (|relations.total Z POW Z| X Y)
       (|set.intent POW (Z x POW Z)|
         (lambda ((f |POW (Z x POW Z)|))
           (= (|rel.domain Z POW Z| f) X)))))
  :named |ax:set.in.relations.total (Z x POW Z)|
))
;; >->> (Z x POW Z) Z
(declare-fun |bijections.total (Z x POW Z) Z| (|POW (Z x POW Z)| |POW Z|) |POW POW ((Z x POW Z) x Z)|)
(assert(!
(forall ((e1 |POW (Z x POW Z)|) (e2 |POW Z|))
    (= (|bijections.total (Z x POW Z) Z| e1 e2)
       (|set.inter POW ((Z x POW Z) x Z)|
         (|functions.total (Z x POW Z) Z| e1 e2)
         (|bijections (Z x POW Z) Z| e1 e2))))
  :named |ax:def.tbij ((Z x POW Z) x Z)|))
;; Cardinals constructor
(declare-datatype Cardinals ( ( Infinite ) ( Finite ( Value Int ) )))
;; ..
(declare-fun |interval| (|Z| |Z|) |POW Z|)
(assert (!
  (forall ((l |Z|)(u |Z|))
    (= (|interval| l u)
      (|set.intent Z| (lambda ((e |Z|)) (and (<= l e) (<= e u))))))
  :named |ax.set.in.interval|))
;; >->> POW Z Z
(declare-fun |bijections.total POW Z Z| (|POW POW Z| |POW Z|) |POW POW (POW Z x Z)|)
(assert(!
(forall ((e1 |POW POW Z|) (e2 |POW Z|))
    (= (|bijections.total POW Z Z| e1 e2)
       (|set.inter POW (POW Z x Z)|
         (|functions.total POW Z Z| e1 e2)
         (|bijections POW Z Z| e1 e2))))
  :named |ax:def.tbij (POW Z x Z)|))
;; ⊆ POW (Z x POW Z)
(declare-fun |set.subseteq POW (Z x POW Z)| (|POW POW (Z x POW Z)| |POW POW (Z x POW Z)|) Bool)
(assert (!
  (forall ((s |POW POW (Z x POW Z)|) (t |POW POW (Z x POW Z)|))
    (=
      (|set.subseteq POW (Z x POW Z)| s t)
      (forall ((e |POW (Z x POW Z)|)) (=> (|set.in POW (Z x POW Z)| e s) (|set.in POW (Z x POW Z)| e t)))))
  :named |ax.set.subseteq POW (Z x POW Z)|))
;; --> Z POW Z
(declare-fun |functions.total Z POW Z| (|POW Z| |POW POW Z|) |POW POW (Z x POW Z)|)
(assert (!
  (forall ((e1 |POW Z|) (e2 |POW POW Z|))
    (= (|functions.total Z POW Z| e1 e2)
       (|set.intent POW (Z x POW Z)|
         (lambda ((f |POW (Z x POW Z)|))
           (and (|set.in POW (Z x POW Z)| f (|functions.partial Z POW Z| e1 e2))
            (|set.in POW (Z x POW Z)| f (|relations.total Z POW Z| e1 e2)))))))
  :named |ax:def.tfun (Z x POW Z)|))
;; card (Z x POW Z)
(declare-fun |card (Z x POW Z)| (|POW (Z x POW Z)|) Cardinals)
  (assert (!
  (forall ((s |POW (Z x POW Z)|) (n Z))
    (= (= (Value (|card (Z x POW Z)| s)) n)
        (exists ((f |POW ((Z x POW Z) x Z)|))
          (|set.in POW ((Z x POW Z) x Z)| f (|bijections.total (Z x POW Z) Z| s (|interval| 1 n))))))
  :named |ax.card.definition (Z x POW Z)|))
(assert (!
  (forall ((s |POW (Z x POW Z)|))
    (= (= (|card (Z x POW Z)| s) Infinite)
       (forall ((n Z))
         (not (exists ((f |POW ((Z x POW Z) x Z)|))
           (|set.in POW ((Z x POW Z) x Z)| f (|bijections.total (Z x POW Z) Z| s (|interval| 1 n))))))))
  :named |ax.card.definition1 (Z x POW Z)|))
;; card POW Z
(declare-fun |card POW Z| (|POW POW Z|) Cardinals)
  (assert (!
  (forall ((s |POW POW Z|) (n Z))
    (= (= (Value (|card POW Z| s)) n)
        (exists ((f |POW (POW Z x Z)|))
          (|set.in POW (POW Z x Z)| f (|bijections.total POW Z Z| s (|interval| 1 n))))))
  :named |ax.card.definition POW Z|))
(assert (!
  (forall ((s |POW POW Z|))
    (= (= (|card POW Z| s) Infinite)
       (forall ((n Z))
         (not (exists ((f |POW (POW Z x Z)|))
           (|set.in POW (POW Z x Z)| f (|bijections.total POW Z Z| s (|interval| 1 n))))))))
  :named |ax.card.definition1 POW Z|))
;; injections Z POW Z
(declare-fun |injections Z POW Z| (|POW Z| |POW POW Z|) |POW POW (Z x POW Z)|)
(assert (!
  (forall ((X |POW Z|) (Y |POW POW Z|))
    (= (|injections Z POW Z| X Y)
       (|set.intent POW (Z x POW Z)|
         (lambda ((f |POW (Z x POW Z)|))
           (forall ((p |(Z x POW Z)|) (q |(Z x POW Z)|))
             (=> (and (|set.in (Z x POW Z)| p f) (|set.in (Z x POW Z)| q f) (= (snd p) (snd q)))
                 (= (fst p) (fst q))))))))
  :named |ax:set.in.injections (Z x POW Z)|))
;; Natural1 constructor
(declare-const NATURAL1 |POW Z|)
(assert (!
  (= NATURAL1 (|set.intent Z| (lambda ((e |Z|)) (<= 1 e)))) :named |ax.set.in.NATURAL1|))
;; seq POW Z
(declare-fun |seq POW Z| (|POW POW Z|) |POW POW (Z x POW Z)|)
(assert (!
  (forall ((E |POW POW Z|) (s |POW (Z x POW Z)|))
    (=>
      (|set.in POW (Z x POW Z)| s (|seq POW Z| E))
      ((_ is Finite) (|card (Z x POW Z)| s))))
  :named |ax.seq.is.finite POW Z|))
(assert (!
  (forall ((E |POW POW Z|))
    (|set.subseteq POW (Z x POW Z)|
      (|seq POW Z| E)
      (|functions.total Z POW Z| (|interval| 1 (Value (|card POW Z| E))) E)))
  :named |ax.seq POW Z|))
;; ⊆ Z
(declare-fun |set.subseteq Z| (|POW Z| |POW Z|) Bool)
(assert (!
  (forall ((s |POW Z|) (t |POW Z|))
    (=
      (|set.subseteq Z| s t)
      (forall ((e |Z|)) (=> (|set.in Z| e s) (|set.in Z| e t)))))
  :named |ax.set.subseteq Z|))
;; iseq POW Z
(declare-fun |iseq POW Z| (|POW POW Z|) |POW POW (Z x POW Z)|)
(assert (!
(forall ((E |POW POW Z|)) 
  (= (|iseq POW Z| E)
    (|set.intent POW (Z x POW Z)| (lambda ((s |POW (Z x POW Z)|)) (and (|set.in POW (Z x POW Z)| s (|seq POW Z| E))
    (|set.in POW (Z x POW Z)| s (|injections Z POW Z| NATURAL1 E)))))))
      :named |ax.iseq POW Z|))
;; POW Z
(declare-fun |sub-sets Z| (|POW Z|) |POW POW Z|)
(assert (!
(forall ((t |POW Z|)) (= (|sub-sets Z| t)
(|set.intent POW Z| (lambda ((s |POW Z|)) (|set.subseteq Z| s t)))))
  :named |ax.sub-sets Z|))
;; Integer constructor
;; universe Z
(declare-const INTEGER |POW Z|)
(assert (!
  (= INTEGER (|set.intent Z| (lambda ((e |Z|)) true) ))
  :named |ax.rw.universe Z|))
(assert (!
    (not
      (|set.in POW (Z x POW Z)| (|set.intent (Z x POW Z)| (lambda ((_c0 |(Z x POW Z)|)) (or (= _c0 (maplet 1 (|set.intent Z| (lambda ((_c1 |Z|)) (or (= _c1 0)(= _c1 1)(= _c1 0))))))(= _c0 (maplet 2 (|set.intent Z| (lambda ((_c1 |Z|)) (= _c1 0)))))(= _c0 (maplet 3 (|set.intent Z| (lambda ((_c1 |Z|)) (or (= _c1 0)(= _c1 1)(= _c1 0))))))(= _c0 (maplet 4 (|set.intent Z| (lambda ((_c1 |Z|)) (= _c1 (- 1))))))))) (|iseq POW Z| (|sub-sets Z| INTEGER))))
    :named |Goal|))
(check-sat)
(exit)
