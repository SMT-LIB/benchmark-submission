              (|set.in POW (Z x Z)| f (|surjections Z Z| X Y))))
      :pattern ((|set.in POW (Z x Z)| f (|bijections Z Z| X Y)))))
  :named |ax:set.in.bijections (Z x Z)|))
;; --> Z Z
    (declare-fun |functions.total Z Z| (|POW Z| |POW Z|) |POW POW (Z x Z)|)
    (assert (!
  (forall ((e1 |POW Z|) (e2 |POW Z|) (f |POW (Z x Z)|)) (!
    (= (|set.in POW (Z x Z)| f (|functions.total Z Z| e1 e2))
       (and (|set.in POW (Z x Z)| f (|functions.partial Z Z| e1 e2))
            (|set.in POW (Z x Z)| f (|relations.total Z Z| e1 e2))))
    :pattern ( (|set.in POW (Z x Z)| f (|functions.total Z Z| e1 e2)) )))
  :named |ax:def.tfun (Z x Z)|))
;; >->> (Z x Z) Z
    (declare-fun |bijections.total (Z x Z) Z| (|POW (Z x Z)| |POW Z|) |POW POW ((Z x Z) x Z)|)
    (assert (!
  (forall ((e1 |POW (Z x Z)|) (e2 |POW Z|) (f |POW ((Z x Z) x Z)|))
    (!
      (= (|set.in POW ((Z x Z) x Z)| f (|bijections.total (Z x Z) Z| e1 e2))
         (and (|set.in POW ((Z x Z) x Z)| f (|functions.total (Z x Z) Z| e1 e2))
              (|set.in POW ((Z x Z) x Z)| f (|bijections (Z x Z) Z| e1 e2))))
      :pattern ((|set.in POW ((Z x Z) x Z)| f (|bijections.total (Z x Z) Z| e1 e2)))))
  :named |ax:def.tbij ((Z x Z) x Z)|))
;; Cardinals constructor
(declare-datatype Cardinals ( ( Infinite ) ( Finite ( Value Int ) )))
;; ..
      (declare-fun |interval| (|Z| |Z|) |POW Z|)
      (assert (!
  (forall ((l |Z|)(u |Z|)(e |Z|)) (!
    (= (|set.in Z| e (|interval| l u))
      (and (<= l e) (<= e u)))
    :pattern ((|set.in Z| e (|interval| l u)))))
  :named |ax.set.in.interval|))
;; >->> Z Z
    (declare-fun |bijections.total Z Z| (|POW Z| |POW Z|) |POW POW (Z x Z)|)
    (assert (!
  (forall ((e1 |POW Z|) (e2 |POW Z|) (f |POW (Z x Z)|))
    (!
      (= (|set.in POW (Z x Z)| f (|bijections.total Z Z| e1 e2))
         (and (|set.in POW (Z x Z)| f (|functions.total Z Z| e1 e2))
              (|set.in POW (Z x Z)| f (|bijections Z Z| e1 e2))))
      :pattern ((|set.in POW (Z x Z)| f (|bijections.total Z Z| e1 e2)))))
  :named |ax:def.tbij (Z x Z)|))
;; {} (Z x Z)
    (declare-const |set.empty (Z x Z)| |POW (Z x Z)|)
    (assert (!
  (forall ((e |(Z x Z)|)) (!
    (not (|set.in (Z x Z)| e |set.empty (Z x Z)|))
    :pattern ((|set.in (Z x Z)| e |set.empty (Z x Z)|))))
  :named |ax.set.in.empty (Z x Z)|))
;; ⊆ POW (Z x Z)
    (declare-fun |set.subseteq POW (Z x Z)| (|POW POW (Z x Z)| |POW POW (Z x Z)|) Bool)
    (assert (!
  (forall ((s |POW POW (Z x Z)|) (t |POW POW (Z x Z)|) (e |POW (Z x Z)|))
    (!
      (=>
        (and (|set.subseteq POW (Z x Z)| s t) (|set.in POW (Z x Z)| e s))
        (|set.in POW (Z x Z)| e t))
    :pattern ((|set.subseteq POW (Z x Z)| s t) (|set.in POW (Z x Z)| e s))))
  :named |ax.set.subseteq.elim POW (Z x Z)|))
(assert (!
  (forall ((s |POW POW (Z x Z)|) (t |POW POW (Z x Z)|))
    (=>
      (forall ((e |POW (Z x Z)|)) (=> (|set.in POW (Z x Z)| e s) (|set.in POW (Z x Z)| e t)))
      (|set.subseteq POW (Z x Z)| s t)))
  :named |ax.set.subseteq.intro POW (Z x Z)|))
;; card (Z x Z)
  (declare-fun |card (Z x Z)| (|POW (Z x Z)|) Cardinals)
  (assert (!
  (forall ((s |POW (Z x Z)|)) (!
    (or (= (|card (Z x Z)| s) Infinite)
        (exists ((f |POW ((Z x Z) x Z)|))
          (|set.in POW ((Z x Z) x Z)| f (|bijections.total (Z x Z) Z| s (|interval| 1 (Value (|card (Z x Z)| s)))))))
    :pattern ((|card (Z x Z)| s))))
  :named |ax.card.definition (Z x Z)|))
;; card Z
  (declare-fun |card Z| (|POW Z|) Cardinals)
  (assert (!
  (forall ((s |POW Z|)) (!
    (or (= (|card Z| s) Infinite)
        (exists ((f |POW (Z x Z)|))
          (|set.in POW (Z x Z)| f (|bijections.total Z Z| s (|interval| 1 (Value (|card Z| s)))))))
    :pattern ((|card Z| s))))
  :named |ax.card.definition Z|))
;; [] Z
    (declare-const |seq.empty Z| |POW (Z x Z)|)
    (assert (!
  (= |seq.empty Z| |set.empty (Z x Z)|)
  :named |ax:seq.empty.def Z|))
;; seq Z
    (declare-fun |seq Z| (|POW Z|) |POW POW (Z x Z)|)
    (assert (!
  (forall ((E |POW Z|) (s |POW (Z x Z)|))
    (! (= (|set.in POW (Z x Z)| s (|seq Z| E))
      (and (|set.in POW (Z x Z)| s (|functions.total Z Z| (|interval| 1 (Value (|card (Z x Z)| s))) E))
      ((_ is Finite) (|card (Z x Z)| s))))
  :pattern ((|set.in POW (Z x Z)| s (|seq Z| E)))))
  :named |ax.seq Z|))
;; seq1 Z
    (declare-fun |seq1 Z| (|POW Z|) |POW POW (Z x Z)|)
    (assert (!
  (forall ((E |POW Z|) (s |POW (Z x Z)|))
    (! (= (|set.in POW (Z x Z)| s (|seq1 Z| E))
          (and (|set.in POW (Z x Z)| s (|seq Z| E))
               (not (= s |seq.empty Z|))))
       :pattern ((|set.in POW (Z x Z)| s (|seq1 Z| E)))))
  :named |ax.seq1 Z|))
(assert (!
      (not
        (|set.in POW (Z x Z)| |set.empty (Z x Z)| (|seq1 Z| (|set.intent Z| (lambda ((_c0 |Z|)) (or (= _c0 1)(= _c0 2)(= _c0 3)))))))
      :named |Goal|))
    (check-sat)
(exit)
